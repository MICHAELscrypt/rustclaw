[Unit]
Description=rustclaw - Telegram Linux AI agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/rustclaw
ExecStart=/opt/rustclaw/rustclaw /etc/rustclaw/config.jsonc
StateDirectory=rustclaw
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
