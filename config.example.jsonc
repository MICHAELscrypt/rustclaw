{
  "telegram_bot_token": "REPLACE_ME",
  "allowed_user_ids": [123456789],
  "openrouter_api_key": "REPLACE_ME",
  "default_model": "default",
  "models": {
    "default": {
      "model": "z-ai/glm-5.3-flash",
      "provider": {
        "zdr": false,
        "order": ["Tenstorrent", "Morph", "Z.AI"],
        "allow_fallbacks": false,
        "require_parameters": true
      }
    },
    "myModelConfig-3": {
      "model": "anthropic/claude-sonnet-4",
      "temperature": 0.2
    }
  },
  "system_prompt": "You are a helpful Linux computer assistant. Use the bash tool when needed. Clearly report command failures and results.",
  "state_file": "/var/lib/vm-agent/conversations.json",
  "command_timeout_seconds": 120,
  "max_tool_rounds": 20
}
