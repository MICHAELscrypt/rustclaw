[Unit]
Description=Telegram Linux VM agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/vm-agent
ExecStart=/opt/vm-agent/vm-agent /etc/vm-agent/config.jsonc
StateDirectory=vm-agent
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
